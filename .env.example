# Copy this file to .env and fill in the values. .env is git-ignored; this example holds no secrets.
# Write each line as NAME=value with no quotes and no spaces around the "=".

# Slack Incoming Webhook for pipeline alerts. Create it at https://api.slack.com/apps (your app -> Incoming Webhooks).
# Read by the DAGs as the Airflow Variable SLACK_WEBHOOK_URL. Leave empty to print alerts in the task log instead.
AIRFLOW_VAR_SLACK_WEBHOOK_URL=

# Optional: set to false to stop warning alerts (volume drop, stale feed). Failure alerts always send.
# AIRFLOW_VAR_NAMMAMART_ALERT_ON_WARNINGS=false
